{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run lint && npm test && npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "integration/**": true,
      "release/**": true,
      "preview/**": true
    }
  },
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/@rollup/rollup-linux-x64-gnu/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
