{
  "version": 2,
  "buildCommand": "npm run lint && npm test && npm run build && bash tests/browser/run-central-loop.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/@rollup/rollup-linux-x64-gnu/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
