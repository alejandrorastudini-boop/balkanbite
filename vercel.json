{
  "version": 2,
  "buildCommand": "npx tsx scripts/verify-pantry-consumption.ts && npm run lint && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/@rollup/rollup-linux-x64-gnu/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
